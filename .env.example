# --- Database -------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost:5432/added"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string"

# Used once by `npm run db:seed` to create the first admin.
ADMIN_EMAIL="admin@addedforms.com"
ADMIN_PASSWORD="change-me"

# --- Storage --------------------------------------------------------------
# "local" writes to UPLOAD_DIR and serves the files from /uploads at runtime.
# "s3" uses the S3-compatible settings below.
STORAGE_DRIVER="local"
# UPLOAD_DIR="./uploads"
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="added-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://media.addedforms.com"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
